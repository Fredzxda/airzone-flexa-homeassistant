{
  "integration": "https://github.com/holdestmade/template_climate",
  "note": "Exemple anonymisé des options de quatre instances HACS Template Climate ; référence manuelle, non importable",
  "zones": [
    {
      "zone": 1,
      "options": {
        "current_temperature_template": "{{ state_attr('climate.clim_zone_1', 'current_temperature') }}",
        "fan_modes": [],
        "hvac_mode_template": "{% if is_state('binary_sensor.airzone_zone_1_activee', 'on') %}\n  auto\n{% else %}\n  off\n{% endif %}",
        "icon": "{% set mode = states('sensor.airzone_mode_global') | int(-1) %}\n{% set actif = is_state('binary_sensor.airzone_zone_1_activee', 'on') %}\n\n{% if mode == 4 %}\n  {{ 'mdi:white-balance-sunny' if actif else 'mdi:weather-sunny-off' }}\n{% elif mode == 1 %}\n  {{ 'mdi:snowflake' if actif else 'mdi:snowflake-off' }}\n{% elif mode == 3 %}\n  {{ 'mdi:fan' if actif else 'mdi:fan-off' }}\n{% elif mode == 0 %}\n  {{ 'mdi:stop-circle' if actif else 'mdi:stop-circle-outline' }}\n{% else %}\n  mdi:help-circle-outline\n{% endif %}",
        "max_temp_template": "{{ states('sensor.airzone_zone_1_temp_max') | float(30) }}",
        "min_temp_template": "{{ states('sensor.airzone_zone_1_temp_min') | float(18) }}",
        "modes": [
          "auto",
          "off"
        ],
        "name": "Airzone Zone 1",
        "precision": 0.5,
        "preset_mode_template": "{% set brut = states('sensor.airzone_zone_1_etat_brut') %}\n{% if is_number(brut) %}\n  {{ 'sleep' if (brut | int) % 2 == 1 else 'none' }}\n{% else %}\n  none\n{% endif %}",
        "preset_modes": [
          "none",
          "sleep"
        ],
        "set_hvac_mode": [
          {
            "action": "script.airzone_zone_marche_arret",
            "data": {
              "marche": "{{ hvac_mode != 'off' }}",
              "zone": 1
            },
            "metadata": {}
          }
        ],
        "set_preset_mode": [
          {
            "action": "script.airzone_zone_mode_nuit",
            "data": {
              "actif": "{{ preset_mode == 'sleep' }}",
              "zone": 1
            }
          }
        ],
        "set_temperature": [
          {
            "action": "climate.set_temperature",
            "data": {
              "temperature": "{{ temperature }}"
            },
            "metadata": {},
            "target": {
              "entity_id": "climate.clim_zone_1"
            }
          },
          {
            "delay": {
              "hours": 0,
              "milliseconds": 500,
              "minutes": 0,
              "seconds": 0
            }
          },
          {
            "action": "homeassistant.update_entity",
            "data": {
              "entity_id": [
                "climate.clim_zone_1"
              ]
            }
          }
        ],
        "swing_modes": [],
        "target_temperature_template": "{{ state_attr('climate.clim_zone_1', 'temperature') }}",
        "temp_step": 0.5
      }
    },
